# ============================================================
# Cecilia Tedin Bot — plantilla de variables de entorno
# ============================================================
# Copia este archivo como `.env` y completá los valores reales.
# `.env` NUNCA se committea (ya está en .gitignore).
# En Railway se cargan como Environment Variables desde la UI.
# ============================================================


# ===== Servidor =====
# Puerto local. En Railway lo inyecta el propio Railway, no lo fijes ahí.
PORT=3001

# ===== Meta / WhatsApp Cloud API =====
# Token de la app de WhatsApp Business (larga vida, System User).
WHATSAPP_TOKEN=

# ID del número de WhatsApp Business.
PHONE_NUMBER_ID=

# ID de la cuenta WABA (solo referencia, no lo pide el runtime).
WABA_ID=

# Versión de Graph API que usamos para construir URLs.
GRAPH_API_VERSION=v25.0

# Token de verificación del webhook (lo definís vos, y lo pegás igual en Meta).
VERIFY_TOKEN=

# App Secret de la app de Meta (para validar X-Hub-Signature-256).
# OBLIGATORIO en producción; sin esto, el proceso no arranca en NODE_ENV=production.
APP_SECRET=


# ===== Imágenes del catálogo (media IDs subidas a Meta) =====
IMAGE_MODELO_1=
IMAGE_MODELO_2=
IMAGE_MODELO_3=
IMAGE_OFERTA_DIA=


# ===== Base de datos (Neon Postgres) =====
# URL completa incluyendo `sslmode=require` (Neon lo exige).
DATABASE_URL=


# ===== Dashboard admin =====
# Password compartida para entrar al panel /dashboard. Cambiala siempre en prod.
DASHBOARD_PASSWORD=


# ===== Entorno =====
# En Railway ponerlo en "production". En local dejarlo vacío o "development".
NODE_ENV=
